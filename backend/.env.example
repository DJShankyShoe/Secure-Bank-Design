# SecureBank backend — environment configuration TEMPLATE (SR-07).
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# The app FAILS TO START if any REQUIRED variable below is missing or malformed.

# ── Flask ────────────────────────────────────────────────────────────────────
# High-entropy session-signing key. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
FLASK_SECRET_KEY=

# ── Database DSNs — three least-privilege roles ───────────────────────
# app_user: SELECT/INSERT/UPDATE/DELETE on application + session schemas.
DATABASE_URL_APP=postgresql+psycopg2://app_user:CHANGE_ME@localhost:5432/securebank
# audit_writer: INSERT-ONLY on the audit schema. No SELECT/UPDATE/DELETE.
DATABASE_URL_AUDIT_WRITER=postgresql+psycopg2://audit_writer:CHANGE_ME@localhost:5432/securebank
# admin_reader: SELECT-ONLY on the audit schema (admin audit review).
DATABASE_URL_ADMIN_READER=postgresql+psycopg2://admin_reader:CHANGE_ME@localhost:5432/securebank

# ── Encryption (SR-03/SR-11) ─────────────────────────────────────────────────
# base64 of a 32-byte key for AES-256-GCM (NRIC + TOTP seed). Generate:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Must decode to EXACTLY 32 bytes or startup aborts.
AES_ENCRYPTION_KEY=

# ── Email (smtplib) ─────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
# SMTP_USER / SMTP_PASSWORD optional (omit for an unauthenticated local relay).
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@securebank.example

# ── MFA (pyotp, SR-11) ───────────────────────────────────────────────────────
TOTP_ISSUER=SecureBank

# ── Proxy / TLS posture (SR-02) ─────────────────────────────────
# App sits behind nginx/Cloudflare. Keep "true" in prod so Talisman force_https
# is on (it honours X-Forwarded-Proto via ProxyFix). Set "false" only for local
# http dev to avoid redirect loops.
FORCE_HTTPS=true

# ── Maintenance ──────────────────────────────────────────────────────────────
# In-app periodic cleanup of expired idempotency/email-change/auth-attempt rows
#. Seconds between ticks; a PostgreSQL advisory lock means only ONE
# worker/container prunes per tick, so it's safe with many containers. Set 0 to
# disable and use an external cron (`flask --app app cleanup`) instead.
CLEANUP_INTERVAL_SECONDS=3600
