# Secrets — never commit
.env
*.env
!.env.example

# Local working docs / drafts — not part of the codebase
CLAUDE.md
PROGRESS.md
SSD.sql

# Distribution bundles (local only)
dist/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Tooling
backend/.venv/
dependency-check-report/
reports/
*.log

# Playwright E2E (frontend/e2e) — generated per-run, never committed
frontend/e2e/.auth/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# Windows / WSL metadata
*:Zone.Identifier
node_modules/
